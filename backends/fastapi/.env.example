# Copy to .env (never committed) to override defaults.
# Every setting has a default; the backend runs with zero secrets (mock provider).

LLM_PROVIDER=mock

# Real provider (requires an API key):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# CORS_ORIGINS is parsed as JSON:
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
