# Copy to .env (never committed) to override defaults.
# Every setting has a default; the backend runs with zero secrets in local mock-provider mode.

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# DEPLOYMENT_MODE=local         # default — secretless; mock provider; localhost CORS
# DEPLOYMENT_MODE=shared-demo   # shared ephemeral; needs SESSION_SECRET
# DEPLOYMENT_MODE=production    # fail-closed; requires SESSION_SECRET, explicit CORS_ORIGINS,
#                               # and OPENAI_API_KEY when LLM_PROVIDER=openai

LLM_PROVIDER=mock

# OpenAI (OpenAI-compatible):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=<your-api-key>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Nebius Token Factory (OpenAI-compatible):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=<nebius-api-key>
# OPENAI_BASE_URL=https://api.tokenfactory.nebius.com/v1
# OPENAI_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507

# ---------------------------------------------------------------------------
# CORS — required non-empty and non-wildcard in production mode
# ---------------------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]   # local default
# CORS_ORIGINS=["https://app.example.com"]                         # production example

# ---------------------------------------------------------------------------
# Session secret — required (non-empty) for shared-demo and production modes
# ---------------------------------------------------------------------------
# SESSION_SECRET=<generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))">
# SESSION_TTL_SECONDS=28800
